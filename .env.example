# Copy to .env and fill in. Never commit .env.
# Your domain (an A record pointing at the server). Leave as :80 until DNS is ready.
DOMAIN=:80
# Long random string; protects the admin API (imports, jobs). Generate: openssl rand -hex 32
ADMIN_TOKEN=change-me
# Optional: Israeli ISP proxy for the Tax Authority deals, only if the source check shows
# the cloud server's IP is refused. Format: http://user:pass@host:port
DEALS_PROXY=
