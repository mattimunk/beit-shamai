# Copy to .env and fill in. Never commit .env.
# Your domain (an A record pointing at the server). Leave as :80 until DNS is ready.
DOMAIN=:80
# Long random string; protects the admin API (imports, jobs). Generate: openssl rand -hex 32
ADMIN_TOKEN=change-me
# Optional: Israeli ISP proxy for the Tax Authority deals, only if the source check shows
# the cloud server's IP is refused. Format: http://user:pass@host:port
DEALS_PROXY=
# Contact email sent to OpenStreetMap's address search (their usage policy asks for one).
CONTACT_EMAIL=
# Optional: Google Geocoding API key for address search (paid; better Hebrew coverage).
GOOGLE_MAPS_API_KEY=

# Accounts: email addresses with admin access (comma-separated). Until email sending is set up,
# an admin signs in by typing ADMIN_TOKEN as the code.
ADMIN_EMAILS=
# Email for sign-in codes and notifications – one of (Google Cloud blocks direct SMTP):
#   Resend:  RESEND_API_KEY=re_...      Brevo:  BREVO_API_KEY=xkeysib-...
# The sender must be on a domain verified with that service.
MAIL_FROM=Beit Shamai <no-reply@beitsham.ai>
RESEND_API_KEY=
BREVO_API_KEY=
